{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AegisX Hospital Platform design tokens. Compatible with Style Dictionary, Tokens Studio, and the W3C Design Tokens Community Group format. Consume from Figma, iOS, Android, web, or Flutter via the appropriate transformer.",
  "color": {
    "brand": {
      "navy":     { "$value": "#0f172a", "$type": "color", "$description": "AegisX primary navy — brand bg, dark UI surface" },
      "navy-700": { "$value": "#1e293b", "$type": "color" },
      "navy-600": { "$value": "#334155", "$type": "color" },
      "indigo":   { "$value": "#6366f1", "$type": "color", "$description": "Primary action / brand accent" },
      "indigo-700": { "$value": "#4338ca", "$type": "color" },
      "indigo-600": { "$value": "#4f46e5", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#16a34a", "$type": "color" },
      "warning": { "$value": "#d97706", "$type": "color" },
      "danger":  { "$value": "#dc2626", "$type": "color" },
      "info":    { "$value": "#0891b2", "$type": "color" }
    },
    "surface": {
      "background": { "$value": "#f8fafc", "$type": "color" },
      "card":       { "$value": "#ffffff", "$type": "color" },
      "muted":      { "$value": "#f1f5f9", "$type": "color" },
      "border":     { "$value": "#e2e8f0", "$type": "color" },
      "border-strong": { "$value": "#cbd5e1", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "#0f172a", "$type": "color" },
      "secondary": { "$value": "#475569", "$type": "color" },
      "muted":     { "$value": "#64748b", "$type": "color" },
      "disabled":  { "$value": "#94a3b8", "$type": "color" },
      "inverse":   { "$value": "#ffffff", "$type": "color" }
    },
    "category": {
      "platform":         { "$value": "#2563eb", "$type": "color" },
      "clinical":         { "$value": "#059669", "$type": "color" },
      "diagnostics":      { "$value": "#0891b2", "$type": "color" },
      "finance":          { "$value": "#ca8a04", "$type": "color" },
      "back-office":      { "$value": "#a16207", "$type": "color" },
      "inventory":        { "$value": "#4f46e5", "$type": "color" },
      "facilities":       { "$value": "#475569", "$type": "color" },
      "hr":               { "$value": "#7c3aed", "$type": "color" },
      "compliance":       { "$value": "#a16207", "$type": "color" },
      "thai-integration": { "$value": "#1e3a5f", "$type": "color" },
      "analytics":        { "$value": "#7e22ce", "$type": "color" }
    }
  },
  "spacing": {
    "0":  { "$value": "0",    "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "xl":   { "$value": "16px",  "$type": "dimension" },
    "full": { "$value": "9999px","$type": "dimension" }
  },
  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(15,23,42,0.04)",                                       "$type": "shadow" },
    "sm": { "$value": "0 1px 3px rgba(15,23,42,0.08), 0 1px 2px rgba(15,23,42,0.04)",         "$type": "shadow" },
    "md": { "$value": "0 4px 6px -1px rgba(15,23,42,0.10), 0 2px 4px -2px rgba(15,23,42,0.05)","$type": "shadow" },
    "lg": { "$value": "0 10px 15px -3px rgba(15,23,42,0.10), 0 4px 6px -4px rgba(15,23,42,0.05)","$type": "shadow" },
    "xl": { "$value": "0 20px 25px -5px rgba(15,23,42,0.10), 0 8px 10px -6px rgba(15,23,42,0.04)","$type": "shadow" }
  },
  "font": {
    "family": {
      "ui":   { "$value": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "thai": { "$value": "'IBM Plex Sans Thai', 'Sarabun', sans-serif",                     "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, 'SF Mono', Menlo, monospace",                       "$type": "fontFamily" }
    },
    "size": {
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "14px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "lg":   { "$value": "18px", "$type": "dimension" },
      "xl":   { "$value": "20px", "$type": "dimension" },
      "2xl":  { "$value": "24px", "$type": "dimension" },
      "3xl":  { "$value": "30px", "$type": "dimension" },
      "4xl":  { "$value": "36px", "$type": "dimension" },
      "5xl":  { "$value": "48px", "$type": "dimension" }
    },
    "weight": {
      "normal":   { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "none":    { "$value": 1.0,   "$type": "number" },
      "tight":   { "$value": 1.25,  "$type": "number" },
      "snug":    { "$value": 1.375, "$type": "number" },
      "normal":  { "$value": 1.5,   "$type": "number" },
      "relaxed": { "$value": 1.625, "$type": "number" }
    }
  },
  "z": {
    "base":     { "$value": "0",    "$type": "number" },
    "dropdown": { "$value": "100",  "$type": "number" },
    "sticky":   { "$value": "200",  "$type": "number" },
    "overlay":  { "$value": "300",  "$type": "number" },
    "modal":    { "$value": "400",  "$type": "number" },
    "popover":  { "$value": "500",  "$type": "number" },
    "toast":    { "$value": "600",  "$type": "number" }
  }
}
