{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Component-level tokens from production _aegisx-tokens.scss: form layout, surface/border per role, state layers, opacity, grid, a11y.",
  "form": {
    "gap": {
      "dense":   { "$value": "0.75rem", "$type": "dimension", "$description": "12px — compact forms" },
      "default": { "$value": "1rem",    "$type": "dimension", "$description": "16px — standard form gap" },
      "relaxed": { "$value": "1rem",    "$type": "dimension", "$description": "16px — relaxed form gap" }
    },
    "sectionGap": { "$value": "2.5rem",  "$type": "dimension", "$description": "40px — gap between form sections" },
    "cardPadding": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — padding inside form cards" }
  },
  "control": {
    "$description": "Form control sizing (button / input / select / textarea / chip / etc). Density-aware: [data-density=compact] shrinks, [data-density=spacious] expands. Values align with Angular Material density scale so .ax-* heights match <mat-*> heights exactly when both share a density.",
    "height": {
      "sm": { "$value": "2.5rem",  "$type": "dimension", "$description": "40px — compact (Mat density=-4)" },
      "md": { "$value": "3rem",    "$type": "dimension", "$description": "48px — default (Mat density=-2)" },
      "lg": { "$value": "3.5rem",  "$type": "dimension", "$description": "56px — spacious (Mat density=0)" }
    },
    "paddingX": {
      "sm": { "$value": "0.625rem", "$type": "dimension", "$description": "10px" },
      "md": { "$value": "0.875rem", "$type": "dimension", "$description": "14px" },
      "lg": { "$value": "1.125rem", "$type": "dimension", "$description": "18px" }
    },
    "paddingY": {
      "sm": { "$value": "0.375rem", "$type": "dimension", "$description": "6px" },
      "md": { "$value": "0.625rem", "$type": "dimension", "$description": "10px" },
      "lg": { "$value": "0.875rem", "$type": "dimension", "$description": "14px" }
    },
    "gap": {
      "sm": { "$value": "0.375rem", "$type": "dimension", "$description": "6px  — compact inline gap" },
      "md": { "$value": "0.5rem",   "$type": "dimension", "$description": "8px  — default inline gap" },
      "lg": { "$value": "0.625rem", "$type": "dimension", "$description": "10px — spacious inline gap" }
    },
    "iconSize": {
      "sm": { "$value": "1rem",     "$type": "dimension", "$description": "16px" },
      "md": { "$value": "1.125rem", "$type": "dimension", "$description": "18px" },
      "lg": { "$value": "1.25rem",  "$type": "dimension", "$description": "20px" }
    }
  },
  "focusRing": {
    "$description": "Focus-visible outline applied to all interactive controls. Both .ax-* and Material MDC overrides reference these tokens.",
    "width":  { "$value": "2px",     "$type": "dimension" },
    "offset": { "$value": "2px",     "$type": "dimension" },
    "opacity": { "$value": 0.5,      "$type": "number" }
  },
  "surface": {
    "$description": "Per-role surface backgrounds (light mode)",
    "info":    { "$value": "#dbeafe", "$type": "color" },
    "warning": { "$value": "#fef3c7", "$type": "color" },
    "success": { "$value": "#d1fae5", "$type": "color" },
    "error":   { "$value": "#fee2e2", "$type": "color" }
  },
  "roleBorder": {
    "$description": "Per-role border colors (light mode)",
    "info":    { "$value": "#93c5fd", "$type": "color" },
    "warning": { "$value": "#fcd34d", "$type": "color" },
    "success": { "$value": "#6ee7b7", "$type": "color" },
    "error":   { "$value": "#fca5a5", "$type": "color" }
  },
  "state": {
    "hover":   { "$value": 0.08, "$type": "number", "$description": "M3 state layer — hover" },
    "focus":   { "$value": 0.12, "$type": "number", "$description": "M3 state layer — focus" },
    "pressed": { "$value": 0.12, "$type": "number", "$description": "M3 state layer — pressed" },
    "dragged": { "$value": 0.16, "$type": "number", "$description": "M3 state layer — dragged" }
  },
  "opacity": {
    "disabled": { "$value": 0.4, "$type": "number" },
    "hover":    { "$value": 0.8, "$type": "number" },
    "active":   { "$value": 0.6, "$type": "number" }
  },
  "grid": {
    "columns": { "$value": 12,     "$type": "number" },
    "gutter":  { "$value": "24px", "$type": "dimension" }
  },
  "a11y": {
    "touchTargetMin":        { "$value": "48px", "$type": "dimension", "$description": "Minimum touch target (WCAG 2.5.8)" },
    "textMinContrast":       { "$value": 4.5,    "$type": "number",    "$description": "AA minimum contrast ratio" },
    "textEnhancedContrast":  { "$value": 7,      "$type": "number",    "$description": "AAA enhanced contrast ratio" }
  }
}
