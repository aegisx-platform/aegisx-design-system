{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Shadows matched to production _aegisx-tokens.scss.",
  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "xs":   { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$type": "shadow" },
    "sm":   { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$type": "shadow", "$description": "Cards, raised surfaces" },
    "md":   { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "$type": "shadow", "$description": "Dropdowns, popovers" },
    "lg":   { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "$type": "shadow", "$description": "Modals, slideouts" },
    "xl":   { "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)", "$type": "shadow", "$description": "Toasts, max elevation" }
  },
  "elevation": {
    "0": { "$value": "none", "$type": "shadow", "$description": "Flat — border only (tables, inline sections)" },
    "1": { "$value": "{shadow.sm}", "$type": "shadow", "$description": "Raised — cards, panels" },
    "2": { "$value": "{shadow.md}", "$type": "shadow", "$description": "Floating — dropdowns, popovers" },
    "3": { "$value": "{shadow.lg}", "$type": "shadow", "$description": "Overlay — modals" },
    "4": { "$value": "{shadow.xl}", "$type": "shadow", "$description": "Toast — notifications" }
  },
  "focusRing": {
    "width":   { "$value": "2px",     "$type": "dimension", "$description": "Focus ring width" },
    "offset":  { "$value": "2px",     "$type": "dimension", "$description": "Focus ring offset" },
    "opacity": { "$value": "0.5",     "$type": "number",    "$description": "Focus ring opacity" },
    "color":   { "$value": "#3b82f6", "$type": "color",     "$description": "Focus ring color — Blue-500" }
  }
}
