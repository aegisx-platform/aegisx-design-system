{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Untitled UI–aligned shadows. AegisX uses lighter elevation than Material default — subtle borders do most of the work.",
  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "xs":   { "$value": "0 1px 2px 0 rgb(16 24 40 / 0.05)", "$type": "shadow" },
    "sm":   { "$value": "0 1px 2px 0 rgb(16 24 40 / 0.06), 0 1px 3px 0 rgb(16 24 40 / 0.10)", "$type": "shadow", "$description": "Cards, raised surfaces" },
    "md":   { "$value": "0 2px 4px -2px rgb(16 24 40 / 0.06), 0 4px 8px -2px rgb(16 24 40 / 0.10)", "$type": "shadow", "$description": "Dropdowns, popovers" },
    "lg":   { "$value": "0 4px 6px -2px rgb(16 24 40 / 0.03), 0 12px 16px -4px rgb(16 24 40 / 0.08)", "$type": "shadow", "$description": "Modals, slideouts" },
    "xl":   { "$value": "0 8px 8px -4px rgb(16 24 40 / 0.03), 0 20px 24px -4px rgb(16 24 40 / 0.08)", "$type": "shadow", "$description": "Toasts, max elevation" }
  },
  "elevation": {
    "0": { "$value": "none", "$type": "shadow", "$description": "Flat — border only (tables, inline sections)" },
    "1": { "$value": "{shadow.sm}", "$type": "shadow", "$description": "Raised — cards, panels" },
    "2": { "$value": "{shadow.md}", "$type": "shadow", "$description": "Floating — dropdowns, popovers" },
    "3": { "$value": "{shadow.lg}", "$type": "shadow", "$description": "Overlay — modals" },
    "4": { "$value": "{shadow.xl}", "$type": "shadow", "$description": "Toast — notifications" }
  },
  "focusRing": {
    "$value": "0 0 0 3px rgb(99 102 241 / 0.18)",
    "$type": "shadow",
    "$description": "Brand indigo @ 18% — use on interactive focus states"
  }
}
