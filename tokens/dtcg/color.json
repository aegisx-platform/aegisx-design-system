{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AegisX color tokens. Brand = Material Indigo (#3f51b5). Gray scale = Zinc (light) + Gray (dark/Tremor).",
  "color": {
    "palette": {
      "zinc": {
        "50":  { "$value": "#fafafa", "$type": "color" },
        "100": { "$value": "#f4f4f5", "$type": "color" },
        "200": { "$value": "#e4e4e7", "$type": "color" },
        "300": { "$value": "#d4d4d8", "$type": "color" },
        "400": { "$value": "#a1a1aa", "$type": "color" },
        "500": { "$value": "#71717a", "$type": "color" },
        "600": { "$value": "#52525b", "$type": "color" },
        "700": { "$value": "#3f3f46", "$type": "color" },
        "800": { "$value": "#27272a", "$type": "color" },
        "900": { "$value": "#18181b", "$type": "color" },
        "950": { "$value": "#09090b", "$type": "color" }
      },
      "gray": {
        "$description": "Tailwind Gray — used for dark-mode text (Tremor palette)",
        "50":  { "$value": "#f9fafb", "$type": "color" },
        "100": { "$value": "#f3f4f6", "$type": "color" },
        "200": { "$value": "#e5e7eb", "$type": "color" },
        "300": { "$value": "#d1d5db", "$type": "color" },
        "400": { "$value": "#9ca3af", "$type": "color" },
        "500": { "$value": "#6b7280", "$type": "color" },
        "600": { "$value": "#4b5563", "$type": "color" },
        "700": { "$value": "#374151", "$type": "color" },
        "800": { "$value": "#1f2937", "$type": "color" },
        "900": { "$value": "#111827", "$type": "color" }
      },
      "indigo": {
        "$description": "Material Design Indigo — NOT Tailwind Indigo",
        "50":  { "$value": "#e8eaf6", "$type": "color" },
        "100": { "$value": "#c5cae9", "$type": "color" },
        "200": { "$value": "#9fa8da", "$type": "color" },
        "300": { "$value": "#7986cb", "$type": "color" },
        "400": { "$value": "#5c6bc0", "$type": "color" },
        "500": { "$value": "#3f51b5", "$type": "color" },
        "600": { "$value": "#3949ab", "$type": "color" },
        "700": { "$value": "#303f9f", "$type": "color" },
        "800": { "$value": "#283593", "$type": "color" },
        "900": { "$value": "#1a237e", "$type": "color" }
      },
      "emerald": {
        "$description": "Production success color (Emerald, not Green)",
        "50":  { "$value": "#ecfdf5", "$type": "color" },
        "100": { "$value": "#d1fae5", "$type": "color" },
        "200": { "$value": "#a7f3d0", "$type": "color" },
        "300": { "$value": "#6ee7b7", "$type": "color" },
        "400": { "$value": "#34d399", "$type": "color" },
        "500": { "$value": "#10b981", "$type": "color" },
        "600": { "$value": "#059669", "$type": "color" },
        "700": { "$value": "#047857", "$type": "color" },
        "800": { "$value": "#065f46", "$type": "color" },
        "900": { "$value": "#064e3b", "$type": "color" }
      },
      "amber": {
        "50":  { "$value": "#fffbeb", "$type": "color" },
        "100": { "$value": "#fef3c7", "$type": "color" },
        "200": { "$value": "#fde68a", "$type": "color" },
        "300": { "$value": "#fcd34d", "$type": "color" },
        "400": { "$value": "#fbbf24", "$type": "color" },
        "500": { "$value": "#f59e0b", "$type": "color" },
        "600": { "$value": "#d97706", "$type": "color" },
        "700": { "$value": "#b45309", "$type": "color" },
        "800": { "$value": "#92400e", "$type": "color" },
        "900": { "$value": "#78350f", "$type": "color" }
      },
      "red": {
        "50":  { "$value": "#fef2f2", "$type": "color" },
        "100": { "$value": "#fee2e2", "$type": "color" },
        "200": { "$value": "#fecaca", "$type": "color" },
        "300": { "$value": "#fca5a5", "$type": "color" },
        "400": { "$value": "#f87171", "$type": "color" },
        "500": { "$value": "#ef4444", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" },
        "700": { "$value": "#b91c1c", "$type": "color" },
        "800": { "$value": "#991b1b", "$type": "color" },
        "900": { "$value": "#7f1d1d", "$type": "color" }
      },
      "blue": {
        "50":  { "$value": "#eff6ff", "$type": "color" },
        "100": { "$value": "#dbeafe", "$type": "color" },
        "200": { "$value": "#bfdbfe", "$type": "color" },
        "300": { "$value": "#93c5fd", "$type": "color" },
        "400": { "$value": "#60a5fa", "$type": "color" },
        "500": { "$value": "#3b82f6", "$type": "color" },
        "600": { "$value": "#2563eb", "$type": "color" },
        "700": { "$value": "#1d4ed8", "$type": "color" },
        "800": { "$value": "#1e40af", "$type": "color" },
        "900": { "$value": "#1e3a8a", "$type": "color" }
      },
      "cyan": {
        "50":  { "$value": "#ecfeff", "$type": "color" },
        "100": { "$value": "#cffafe", "$type": "color" },
        "200": { "$value": "#a5f3fc", "$type": "color" },
        "300": { "$value": "#67e8f9", "$type": "color" },
        "400": { "$value": "#22d3ee", "$type": "color" },
        "500": { "$value": "#06b6d4", "$type": "color" },
        "600": { "$value": "#0891b2", "$type": "color" },
        "700": { "$value": "#0e7490", "$type": "color" },
        "800": { "$value": "#155e75", "$type": "color" },
        "900": { "$value": "#164e63", "$type": "color" }
      },
      "purple": {
        "50":  { "$value": "#faf5ff", "$type": "color" },
        "100": { "$value": "#f3e8ff", "$type": "color" },
        "200": { "$value": "#e9d5ff", "$type": "color" },
        "300": { "$value": "#d8b4fe", "$type": "color" },
        "400": { "$value": "#c084fc", "$type": "color" },
        "500": { "$value": "#9333ea", "$type": "color" },
        "600": { "$value": "#7e22ce", "$type": "color" },
        "700": { "$value": "#6b21a8", "$type": "color" },
        "800": { "$value": "#581c87", "$type": "color" },
        "900": { "$value": "#3b0764", "$type": "color" }
      },
      "pink": {
        "50":  { "$value": "#fdf2f8", "$type": "color" },
        "100": { "$value": "#fce7f3", "$type": "color" },
        "200": { "$value": "#fbcfe8", "$type": "color" },
        "300": { "$value": "#f9a8d4", "$type": "color" },
        "400": { "$value": "#f472b6", "$type": "color" },
        "500": { "$value": "#ec4899", "$type": "color" },
        "600": { "$value": "#db2777", "$type": "color" },
        "700": { "$value": "#be185d", "$type": "color" },
        "800": { "$value": "#9d174d", "$type": "color" },
        "900": { "$value": "#831843", "$type": "color" }
      }
    },

    "semantic": {
      "_note": "Values below document the mapping. Actual light/dark forks live in tokens.css via [data-theme=dark] overrides and prefers-color-scheme.",
      "light": {
        "background": {
          "page":     { "$value": "{color.palette.zinc.50}",  "$type": "color", "$description": "App root background" },
          "default":  { "$value": "#ffffff",                   "$type": "color", "$description": "Card/surface bg" },
          "subtle":   { "$value": "{color.palette.zinc.100}", "$type": "color", "$description": "Hover row, divider" },
          "muted":    { "$value": "{color.palette.zinc.50}",  "$type": "color", "$description": "Table stripe, inset panel" },
          "emphasis": { "$value": "{color.palette.zinc.700}", "$type": "color", "$description": "Inverted surface (dark header)" }
        },
        "text": {
          "disabled":  { "$value": "{color.palette.zinc.300}", "$type": "color" },
          "subtle":    { "$value": "{color.palette.zinc.400}", "$type": "color", "$description": "Icon default, placeholder" },
          "secondary": { "$value": "{color.palette.zinc.500}", "$type": "color" },
          "default":   { "$value": "{color.palette.zinc.700}", "$type": "color", "$description": "Body text" },
          "strong":    { "$value": "{color.palette.zinc.900}", "$type": "color" },
          "heading":   { "$value": "#0a0a0a",                  "$type": "color", "$description": "Near-black — production value" },
          "inverted":  { "$value": "#ffffff",                   "$type": "color" }
        },
        "border": {
          "subtle":   { "$value": "{color.palette.zinc.100}", "$type": "color" },
          "default":  { "$value": "{color.palette.zinc.200}", "$type": "color" },
          "emphasis": { "$value": "{color.palette.zinc.300}", "$type": "color" }
        },
        "primary": {
          "light":   { "$value": "{color.palette.indigo.300}", "$type": "color" },
          "default": { "$value": "{color.palette.indigo.500}", "$type": "color", "$description": "Brand / primary action — Material Indigo #3f51b5" },
          "dark":    { "$value": "{color.palette.indigo.700}", "$type": "color" }
        },
        "nav": {
          "bg":          { "$value": "#ffffff",                      "$type": "color" },
          "text":        { "$value": "{color.palette.zinc.600}",    "$type": "color" },
          "text-hover":  { "$value": "{color.palette.zinc.900}",    "$type": "color" },
          "text-active": { "$value": "{color.palette.indigo.600}",  "$type": "color" },
          "bg-active":   { "$value": "{color.palette.indigo.50}",   "$type": "color" }
        },
        "surface": {
          "_note": "Specialized surfaces — theme-locked appearance for objects that look the same regardless of UI theme (printed paper, dev-tool terminal, OS notification bubble).",
          "paper":              { "$value": "{color.palette.zinc.50}",  "$type": "color", "$description": "Printed paper sheet — locked light" },
          "paper-stage":        { "$value": "{color.palette.zinc.200}", "$type": "color", "$description": "Background behind paper preview (flips in dark)" },
          "paper-ink":          { "$value": "#0a0a0a",                    "$type": "color", "$description": "Paper text — locked dark" },
          "paper-ink-soft":     { "$value": "{color.palette.zinc.700}", "$type": "color", "$description": "Paper soft text — locked" },
          "paper-ink-meta":     { "$value": "{color.palette.zinc.500}", "$type": "color", "$description": "Paper meta line — locked" },
          "paper-rule":         { "$value": "#0a0a0a",                    "$type": "color", "$description": "Paper rule/divider — locked dark" },
          "paper-border":       { "$value": "{color.palette.zinc.300}", "$type": "color", "$description": "Paper outline — locked" },
          "paper-row-alt":      { "$value": "{color.palette.zinc.50}",  "$type": "color", "$description": "Paper alt-row — locked" },
          "terminal":           { "$value": "{color.palette.zinc.950}", "$type": "color", "$description": "Dev-tool terminal bg (flips in dark)" },
          "terminal-text":      { "$value": "{color.palette.zinc.200}", "$type": "color", "$description": "Terminal fg — locked" },
          "terminal-meta":      { "$value": "{color.palette.zinc.500}", "$type": "color", "$description": "Terminal meta — locked" },
          "terminal-rule":      { "$value": "{color.palette.zinc.800}", "$type": "color", "$description": "Terminal divider (flips in dark)" },
          "notification-from":  { "$value": "{color.palette.zinc.800}", "$type": "color", "$description": "iOS-style push gradient start — locked dark" },
          "notification-to":    { "$value": "{color.palette.zinc.900}", "$type": "color", "$description": "iOS-style push gradient end — locked dark" },
          "notification-text":  { "$value": "#ffffff",                    "$type": "color", "$description": "Push fg — locked" },
          "notification-shadow":{ "$value": "{color.palette.zinc.950}", "$type": "color", "$description": "Push shadow — locked" }
        },
        "id-band": {
          "_note": "Hospital wristband identity colors (ISO 26825 family). Promoted to design system because pair contrast is a WCAG concern, not a domain decision. Triage / drug-interaction stay as --app-* in consumer apps.",
          "allergy":     { "$value": "{color.palette.red.700}",     "$type": "color", "$description": "Red — allergy alert" },
          "fall-risk":   { "$value": "{color.palette.amber.700}",   "$type": "color", "$description": "Yellow — fall risk" },
          "dnr":         { "$value": "{color.palette.purple.600}",  "$type": "color", "$description": "Purple — DNR" },
          "restricted":  { "$value": "{color.palette.pink.600}",    "$type": "color", "$description": "Pink — restricted extremity" },
          "limb-alert":  { "$value": "{color.palette.emerald.700}", "$type": "color", "$description": "Green — limb alert / latex" }
        }
      },
      "dark": {
        "background": {
          "page":     { "$value": "{color.palette.zinc.950}",  "$type": "color" },
          "default":  { "$value": "{color.palette.gray.900}",  "$type": "color", "$description": "#111827 — Tremor" },
          "subtle":   { "$value": "{color.palette.gray.800}",  "$type": "color", "$description": "#1f2937 — Tremor" },
          "muted":    { "$value": "#131a2b",                    "$type": "color", "$description": "Tremor deep navy" },
          "emphasis": { "$value": "{color.palette.gray.300}",  "$type": "color", "$description": "#d1d5db — Tremor" }
        },
        "text": {
          "disabled":  { "$value": "{color.palette.gray.600}",  "$type": "color", "$description": "#4b5563" },
          "subtle":    { "$value": "{color.palette.gray.500}",  "$type": "color", "$description": "#6b7280" },
          "secondary": { "$value": "{color.palette.gray.400}",  "$type": "color", "$description": "#9ca3af" },
          "default":   { "$value": "{color.palette.gray.300}",  "$type": "color", "$description": "#d1d5db" },
          "strong":    { "$value": "{color.palette.gray.200}",  "$type": "color" },
          "heading":   { "$value": "{color.palette.gray.100}",  "$type": "color", "$description": "#f3f4f6" },
          "inverted":  { "$value": "{color.palette.gray.900}",  "$type": "color", "$description": "#111827" }
        },
        "border": {
          "subtle":   { "$value": "{color.palette.gray.800}",  "$type": "color" },
          "default":  { "$value": "{color.palette.gray.700}",  "$type": "color" },
          "emphasis": { "$value": "{color.palette.gray.600}",  "$type": "color" }
        },
        "primary": {
          "light":   { "$value": "{color.palette.indigo.200}", "$type": "color" },
          "default": { "$value": "{color.palette.indigo.400}", "$type": "color", "$description": "Softer in dark mode — #5c6bc0" },
          "dark":    { "$value": "{color.palette.indigo.600}", "$type": "color" }
        },
        "surface": {
          "_note": "Surface dark overrides — only the *non-locked* surfaces flip. Locked surfaces (paper, terminal-text, notification-*) keep their light-mode values.",
          "paper-stage":   { "$value": "{color.palette.zinc.900}", "$type": "color", "$description": "Stage darkens to keep contrast against locked-light paper" },
          "terminal":      { "$value": "{color.palette.zinc.900}", "$type": "color", "$description": "Terminal bg lifts slightly in dark theme" },
          "terminal-rule": { "$value": "{color.palette.zinc.700}", "$type": "color", "$description": "Terminal divider lifts in dark" }
        }
      },
      "roles": {
        "_note": "Each role has faint/muted/subtle/default/emphasis/inverted. Brand uses Material Indigo. Success uses Emerald (not Green).",
        "brand": {
          "palette": "{color.palette.indigo}",
          "light": {
            "faint": "#e8eaf6", "muted": "#9fa8da", "subtle": "#7986cb",
            "default": "#3f51b5", "emphasis": "#303f9f"
          },
          "dark": {
            "faint": "#1a237e", "muted": "#283593", "subtle": "#303f9f",
            "default": "#5c6bc0", "emphasis": "#9fa8da", "inverted": "#1a237e"
          }
        },
        "success": {
          "palette": "{color.palette.emerald}",
          "light": {
            "faint": "#d1fae5", "default": "#10b981"
          }
        },
        "warning": {
          "palette": "{color.palette.amber}",
          "light": {
            "faint": "#fef3c7"
          }
        },
        "error": {
          "palette": "{color.palette.red}",
          "light": {
            "faint": "#fee2e2"
          }
        },
        "info": {
          "palette": "{color.palette.blue}",
          "light": {
            "faint": "#dbeafe"
          }
        }
      }
    }
  }
}
