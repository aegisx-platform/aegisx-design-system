{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "radius": {
    "none": { "$value": "0",        "$type": "dimension" },
    "sm":   { "$value": "0.375rem", "$type": "dimension", "$description": "6px"  },
    "md":   { "$value": "0.625rem", "$type": "dimension", "$description": "10px" },
    "lg":   { "$value": "1rem",     "$type": "dimension", "$description": "16px" },
    "xl":   { "$value": "1.25rem",  "$type": "dimension", "$description": "20px" },
    "2xl":  { "$value": "1.5rem",   "$type": "dimension", "$description": "24px" },
    "full": { "$value": "9999px",   "$type": "dimension", "$description": "Pill shape" }
  }
}
