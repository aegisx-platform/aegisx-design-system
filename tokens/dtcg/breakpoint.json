{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "breakpoint": {
    "xs":  { "$value": "0px",    "$type": "dimension", "$description": "Mobile portrait" },
    "sm":  { "$value": "600px",  "$type": "dimension", "$description": "Mobile landscape / small tablet" },
    "md":  { "$value": "960px",  "$type": "dimension", "$description": "Tablet" },
    "lg":  { "$value": "1280px", "$type": "dimension", "$description": "Desktop" },
    "xl":  { "$value": "1440px", "$type": "dimension", "$description": "Large desktop" },
    "2xl": { "$value": "1920px", "$type": "dimension", "$description": "Extra large desktop" }
  },
  "container": {
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "960px",  "$type": "dimension" },
    "lg":  { "$value": "1280px", "$type": "dimension" },
    "xl":  { "$value": "1440px", "$type": "dimension" },
    "2xl": { "$value": "1728px", "$type": "dimension" }
  }
}
