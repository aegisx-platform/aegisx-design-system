{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Typography aligned to aegisx-ui-design skill. IBM Plex Sans Thai primary, Untitled UI scale, 14px base for clinical density.",
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": "\"IBM Plex Sans Thai\", \"IBM Plex Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
        "$type": "fontFamily",
        "$description": "Thai-first stack. Primary brand font."
      },
      "serif": {
        "$value": "Georgia, Cambria, \"Times New Roman\", Times, serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "\"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
        "$type": "fontFamily"
      }
    },

    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight", "$description": "Body, table cells" },
      "medium":   { "$value": 500, "$type": "fontWeight", "$description": "Labels, nav, form labels" },
      "semibold": { "$value": 600, "$type": "fontWeight", "$description": "Section headers, card titles" },
      "bold":     { "$value": 700, "$type": "fontWeight", "$description": "Page titles (sparingly)" }
    },

    "letterSpacing": {
      "tight":   { "$value": "-0.02em", "$type": "dimension", "$description": "Display sizes" },
      "normal":  { "$value": "0",       "$type": "dimension" },
      "wide":    { "$value": "0.025em", "$type": "dimension" },
      "widest":  { "$value": "0.1em",   "$type": "dimension", "$description": "Table header uppercase" }
    },

    "text": {
      "xs": { "$type": "typography", "$value": { "fontSize": "0.75rem",  "lineHeight": "1.125rem", "fontWeight": 400 }, "$description": "12 / 18" },
      "sm": { "$type": "typography", "$value": { "fontSize": "0.875rem", "lineHeight": "1.25rem",  "fontWeight": 400 }, "$description": "14 / 20 — BASE (clinical density)" },
      "md": { "$type": "typography", "$value": { "fontSize": "1rem",     "lineHeight": "1.5rem",   "fontWeight": 400 }, "$description": "16 / 24" },
      "lg": { "$type": "typography", "$value": { "fontSize": "1.125rem", "lineHeight": "1.75rem",  "fontWeight": 400 }, "$description": "18 / 28" },
      "xl": { "$type": "typography", "$value": { "fontSize": "1.25rem",  "lineHeight": "1.875rem", "fontWeight": 400 }, "$description": "20 / 30" }
    },

    "display": {
      "xs":  { "$type": "typography", "$value": { "fontSize": "1.5rem",   "lineHeight": "2rem",     "fontWeight": 600, "letterSpacing": "0" },        "$description": "24 / 32" },
      "sm":  { "$type": "typography", "$value": { "fontSize": "1.875rem", "lineHeight": "2.375rem", "fontWeight": 600, "letterSpacing": "0" },        "$description": "30 / 38" },
      "md":  { "$type": "typography", "$value": { "fontSize": "2.25rem",  "lineHeight": "2.75rem",  "fontWeight": 600, "letterSpacing": "-0.02em" }, "$description": "36 / 44" },
      "lg":  { "$type": "typography", "$value": { "fontSize": "3rem",     "lineHeight": "3.75rem",  "fontWeight": 700, "letterSpacing": "-0.02em" }, "$description": "48 / 60" },
      "xl":  { "$type": "typography", "$value": { "fontSize": "3.75rem",  "lineHeight": "4.5rem",   "fontWeight": 700, "letterSpacing": "-0.02em" }, "$description": "60 / 72" },
      "2xl": { "$type": "typography", "$value": { "fontSize": "4.5rem",   "lineHeight": "5.625rem", "fontWeight": 700, "letterSpacing": "-0.02em" }, "$description": "72 / 90" }
    }
  }
}
