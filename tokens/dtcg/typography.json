{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "typography": {
    "fontFamily": {
      "sans":  { "$value": "Inter, \"Noto Sans Thai\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"", "$type": "fontFamily" },
      "serif": { "$value": "Georgia, Cambria, \"Times New Roman\", Times, serif", "$type": "fontFamily" },
      "mono":  { "$value": "\"JetBrains Mono\", \"Fira Code\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs":   { "$value": "0.75rem",   "$type": "dimension", "$description": "12px" },
      "sm":   { "$value": "0.875rem",  "$type": "dimension", "$description": "14px" },
      "base": { "$value": "1rem",      "$type": "dimension", "$description": "16px" },
      "lg":   { "$value": "1.125rem",  "$type": "dimension", "$description": "18px" },
      "xl":   { "$value": "1.25rem",   "$type": "dimension", "$description": "20px" },
      "2xl":  { "$value": "1.5rem",    "$type": "dimension", "$description": "24px" },
      "3xl":  { "$value": "1.875rem",  "$type": "dimension", "$description": "30px" },
      "4xl":  { "$value": "2.25rem",   "$type": "dimension", "$description": "36px" }
    },
    "fontWeight": {
      "normal":   { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.25", "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.75", "$type": "number" }
    },
    "letterSpacing": {
      "tighter": { "$value": "-0.05em",  "$type": "dimension" },
      "tight":   { "$value": "-0.025em", "$type": "dimension" },
      "normal":  { "$value": "0",        "$type": "dimension" },
      "wide":    { "$value": "0.025em",  "$type": "dimension" },
      "wider":   { "$value": "0.05em",   "$type": "dimension" }
    },
    "m3": {
      "display": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "3.5625rem", "fontWeight": 400, "lineHeight": "4rem",    "letterSpacing": "-0.25px" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "2.8125rem", "fontWeight": 400, "lineHeight": "3.25rem", "letterSpacing": "0" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "2.25rem",   "fontWeight": 400, "lineHeight": "2.75rem", "letterSpacing": "0" } }
      },
      "headline": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "2rem",    "fontWeight": 400, "lineHeight": "2.5rem",  "letterSpacing": "0" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "1.75rem", "fontWeight": 400, "lineHeight": "2.25rem", "letterSpacing": "0" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "1.5rem",  "fontWeight": 400, "lineHeight": "2rem",    "letterSpacing": "0" } }
      },
      "title": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "1.375rem", "fontWeight": 400, "lineHeight": "1.75rem", "letterSpacing": "0" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "1rem",     "fontWeight": 500, "lineHeight": "1.5rem",  "letterSpacing": "0.15px" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.875rem", "fontWeight": 500, "lineHeight": "1.25rem", "letterSpacing": "0.1px" } }
      },
      "body": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "1rem",     "fontWeight": 400, "lineHeight": "1.5rem",  "letterSpacing": "0.5px" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.875rem", "fontWeight": 400, "lineHeight": "1.25rem", "letterSpacing": "0.25px" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.75rem",  "fontWeight": 400, "lineHeight": "1rem",    "letterSpacing": "0.4px" } }
      },
      "label": {
        "large":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.875rem",  "fontWeight": 500, "lineHeight": "1.25rem", "letterSpacing": "0.1px" } },
        "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.75rem",   "fontWeight": 500, "lineHeight": "1rem",    "letterSpacing": "0.5px" } },
        "small":  { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "0.6875rem", "fontWeight": 500, "lineHeight": "1rem",    "letterSpacing": "0.5px" } }
      }
    }
  }
}
